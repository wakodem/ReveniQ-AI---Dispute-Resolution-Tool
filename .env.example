# ReveniQ AI - CSV path and Oracle DB configuration
# Copy to .env and set values for your machine. Do not commit .env.
# Digital COE Gen AI Team

# ---- CSV ----
# Directory containing the dispute CSV (default: project root)
# REVENIQ_CSV_DIR=C:\Users\mangeshw\ReveniQ-AI
# REVENIQ_CSV_FILENAME=dispute_categorisation_60days.csv

# ---- Oracle DB (for Required Action rules, e.g. Rejection Fee Dispute) ----
# REVENIQ_DB_USER=ABPAPPO1
# REVENIQ_DB_PASSWORD=your_password
# REVENIQ_DB_HOST=illnqw1347
# REVENIQ_DB_PORT=1521
# REVENIQ_DB_SID=TSADB1408
# If server returns DPY-3015, set REVENIQ_DB_USE_THICK=1 and install Oracle Instant Client
# REVENIQ_DB_USE_THICK=1
# REVENIQ_DB_ORACLE_HOME=C:\oracle\instantclient_21_3

# ---- AI resolution & recommended action (pick one) ----
# Option A: Ollama (local, free, no quota). Install from https://ollama.com then: ollama run llama3.2
# REVENIQ_LLM_BACKEND=ollama
# OLLAMA_BASE_URL=http://localhost:11434
# OLLAMA_MODEL=llama3.2
# OLLAMA_TEMPERATURE=0.0
# Optional sampling (passed to Ollama options; omit vars to use Ollama defaults)
# OLLAMA_TOP_P=0.75
# OLLAMA_TOP_K=1
# OLLAMA_SEED=42
# HTTP wait for Ollama /api/generate (default in code: 600 seconds). Increase if models are slow.
# OLLAMA_TIMEOUT_SECONDS=600
# Optional: separate timeout for /api/embed (RAG). Defaults to OLLAMA_TIMEOUT_SECONDS if set, else 120.
# OLLAMA_EMBED_TIMEOUT_SECONDS=180
# OLLAMA_PARALLEL_WORKERS=4

# ---- RAG (mandatory for AI resolution unless disabled) ----
# Policy/playbook .txt and .md under docs/rag are embedded and retrieved for every AI call.
# Set REVENIQ_RAG_DISABLED=1 only for local testing without embeddings.
# REVENIQ_RAG_DOCS_DIR=docs/rag
# OLLAMA_EMBED_MODEL=nomic-embed-text
# REVENIQ_RAG_DISABLED=0

# ---- AI resolution: use only RAG doc + memo (no Required Action from DB rule) ----
# When 0 or unset (default), AI gets only the RAG document and memo; put SQL/validation steps in docs/rag
# and the AI will follow that doc. When 1, the app runs the rule and passes its outcome to the AI.
# REVENIQ_AI_USE_RULE_OUTCOME=0

# ---- SQL-grounded resolution (grounded_specs.json + Oracle) ----
# When 1 (default if unset): run pipeline + templates first. Set to 0 for AI-only (RAG + Ollama).
# REVENIQ_SQL_GROUNDED_RESOLUTION=1
# After SQL templates, optionally call Ollama to polish wording while keeping the same SQL decision.
# REVENIQ_GROUNDED_LLM_REFINE=0

# ---- Rule categories: literal SQL and/or AI-generated SQL from RAG ----
# Prefer literal SELECT in docs/rag: use a .sql file or ```sql block starting with:
#   -- REVENIQ_CATEGORY: Rejection Fee Dispute
#   (single SELECT, bind :did for dispute_id, allowed tables only — see ai_sql_runner.py)
# If no literal SQL exists for the category, the app asks Ollama to generate SQL from retrieved policy text.
# REVENIQ_AI_SQL_CATEGORIES=Rejection Fee Dispute
# REVENIQ_USE_AI_SQL=1

